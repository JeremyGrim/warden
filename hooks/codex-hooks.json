{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.mjs\" --host codex",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/session-start.mjs\" --host codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
